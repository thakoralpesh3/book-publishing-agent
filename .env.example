# ==============================================================================
# PublisheR AI • Environment Configuration Template
# Copy this file to .env and insert your real Gemini API key
# ==============================================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-4-argon with auto-fallback)
GEMINI_MODEL=gemini-4-argon

# Default Author & Publisher Details for Listings & Catalogs
DEFAULT_AUTHOR="Alpesh Patel"
DEFAULT_PUBLISHER="InspireBooks Press"
DEFAULT_MARKETPLACE="Amazon.in"

# PublisheR AI Web Studio Port
PORT=8550
