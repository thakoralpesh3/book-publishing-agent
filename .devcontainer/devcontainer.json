{
  "name": "PublisheR AI: Autonomous Book & Kindle Agent (Codespace)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8550],
  "portsAttributes": {
    "8550": {
      "label": "PublisheR Web Console",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "postStartCommand": "nohup python3 main.py serve --port 8550 --no-browser > /tmp/publisher.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
